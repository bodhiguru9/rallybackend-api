# Auto-scaling trigger: scale on CPU, not NetworkOut.
# The previous trigger watched NetworkOut bytes — the wrong signal for a CPU/request-bound
# API (the box can be CPU-pegged while NetworkOut stays low, so it never scales out).
# CPUUtilization is the correct metric for this workload (t3 instances run in unlimited
# credit mode, so sustained CPU won't be throttled — scaling out is the right response).
option_settings:
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    Period: '1'            # evaluate every 1 minute
    BreachDuration: '3'    # must breach for 3 consecutive minutes before acting
    UpperThreshold: '70'   # scale OUT when avg CPU > 70%
    UpperBreachScaleIncrement: '1'
    LowerThreshold: '30'   # scale IN when avg CPU < 30%
    LowerBreachScaleIncrement: '-1'
